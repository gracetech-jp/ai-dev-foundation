{
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make audit-all:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D:*)",
      "Write(docs/requirements/**)",
      "Edit(docs/requirements/**)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.npmrc)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.config/gcloud/**)"
    ],
    "ask": [
      "Bash(*migrate*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(poetry add:*)",
      "Bash(go get:*)",
      "Bash(cargo add:*)",
      "Bash(gem install:*)",
      "Bash(bundle add:*)",
      "Bash(composer require:*)",
      "Bash(gh workflow run:*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-start-rules.sh\"",
            "timeout": 10,
            "statusMessage": "プロジェクトルールを読み込み中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/guard-dangerous.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$NTFY_TOPIC\" ]; then curl -s -H 'Priority: high' -H 'Title: Claude Code' -d '承認待ちです' \"https://ntfy.sh/$NTFY_TOPIC\" > /dev/null; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$NTFY_TOPIC\" ]; then curl -s -H 'Title: Claude Code' -d 'タスク完了しました' \"https://ntfy.sh/$NTFY_TOPIC\" > /dev/null; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
