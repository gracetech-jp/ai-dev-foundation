{
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make audit-all:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)",
      "Bash(git reset *--hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D:*)",
      "Bash(git clean *--force*)",
      "Bash(git checkout .)",
      "Bash(rm *-rf*)",
      "Bash(rm *-fr*)",
      "Bash(rm *-Rf*)",
      "Bash(rm *-fR*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.npmrc)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.netrc)",
      "Read(**/.git-credentials)",
      "Read(**/.kube/**)",
      "Read(**/.docker/config.json)"
    ],
    "ask": [
      "Bash(*migrate*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(poetry add:*)",
      "Bash(go get:*)",
      "Bash(cargo add:*)",
      "Bash(gem install:*)",
      "Bash(bundle add:*)",
      "Bash(composer require:*)",
      "Bash(gh workflow run:*)",
      "mcp__*"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/node/.claude/scripts/session-start-rules.sh",
            "timeout": 10,
            "statusMessage": "プロジェクトルールを読み込み中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/node/.claude/scripts/guard-dangerous.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
