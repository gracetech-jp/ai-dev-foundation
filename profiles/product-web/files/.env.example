# このサービスで使う環境変数の雛形。`cp .env.example .env` して値を設定する。
# 実際に使う変数だけ残し、不要な行は削除・追記すること。
ANTHROPIC_API_KEY=

# --- PostgreSQL（開発は compose の既定値 app/app/app で起動。本番は必ず実値を設定し秘密管理する） ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# SQLAlchemy 接続文字列（compose 内の既定: postgresql+psycopg://app:app@db:5432/app）
DATABASE_URL=
