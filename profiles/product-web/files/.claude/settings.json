{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make audit-all:*)"
    ],
    "ask": [
      "Bash(*migrate*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(pip install:*)",
      "Bash(gh workflow run:*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.npmrc)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.netrc)",
      "Read(**/.git-credentials)",
      "Read(**/.kube/**)",
      "Read(**/.docker/config.json)",
      "Edit(CLAUDE.md)",
      "Edit(docs/rules/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/scripts/guard-dangerous.sh)",
      "Edit(.claude/scripts/session-start-rules.sh)",
      "Edit(.claude/skills/extract-requirements/**)",
      "Edit(.claude/skills/verify-request/**)",
      "Edit(.claude/agents/consistency-auditor.md)",
      "Edit(scripts/pre-push)",
      "Edit(scripts/commit-msg)",
      "Edit(scripts/check-coverage.sh)",
      "Edit(scripts/check-requirements-coverage.sh)",
      "Edit(scripts/check-tier-tripwire.sh)",
      "Edit(.claude/agents/security-reviewer.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-start-rules.sh\"",
            "timeout": 10,
            "statusMessage": "プロジェクトルールを読み込み中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/guard-dangerous.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
