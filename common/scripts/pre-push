#!/usr/bin/env bash
# git pre-push フック — push 前に整合性監査・単体テスト・要件トレーサビリティ・Tierトリップワイヤの4段を実行
# （make all と同じ構成。docs/rules/quality-gates.md §2）
# 基盤リポでは4段目は「機微面なし」宣言（docs/requirements/.tier-tripwire-none）で正当スキップし、
# サービス側では PROJECT.md 由来の機微パターンで実発動する（同一ファイルを配布・ADR-008）。
# インストール: make install-hooks

ROOT="$(git rev-parse --show-toplevel)"

# 共通スクリプトの所在。このフックは .git/hooks から共通側への symlink なので、
# 実体の位置は readlink -f で解く（相対リンクなのでホストでもコンテナでも同じ実体に届く）。
COMMON_SCRIPTS="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# lint を**先頭**に置く。理由は速度で、shellcheck 系は秒で終わる一方、下の4段は分単位かかる。
# 単純な指摘ほど早く返す（この順にしないと「数分待って警告1件で落ちる」になる）。
#
# 【なぜここに lint があるのか（2026-08-07 追加）】
# CI は lint / audit / test / req-coverage / tier-tripwire / secret-scan を回すが、
# フック側は4段しか無く、**lint だけフックに無い**状態だった。フックに無く CI にあるものは
# 「push して数分後に単純な問題で落ちる」フィードバックループを作る——実際に踏んだ
# （SC2015 の info 1件で CI が赤。ローカルは緑）。CI が権威あるゲート、フックはその**高速な部分集合**、
# という役割分担に揃える。両方で走る重複は正常であって、無駄ではない。
#
# 【optional を使う理由】
# 共通の pre-push は全リポジトリが共有する。lint が未実装（TODO=exit 3）でも、そもそも
# ターゲットが無くても、**push を止めない**。フックは便宜であって権威ではなく、契約違反を
# 赤にする役目は CI（softable）が持つ。判定は run-gates.sh に置いてあり bats で固定してある。
echo "[pre-push] lint（静的解析）を実行中..."
if ! bash "$COMMON_SCRIPTS/run-gates.sh" "$ROOT" optional:lint; then
  echo ""
  echo "[pre-push] ❌ lint が失敗しました。push をブロックします。"
  echo "           警告を解消してから再度 push してください（ゼロ警告ゲート）。"
  echo "           チェックをスキップする場合: git push --no-verify"
  exit 1
fi
echo "[pre-push] ✅ lint 通過"

echo ""
echo "[pre-push] 整合性監査（grep整合性・構造監査・マイグレーションdrift）を実行中..."
if ! (cd "$ROOT" && make audit-all); then
  echo ""
  echo "[pre-push] ❌ 整合性監査が失敗しました。push をブロックします。"
  echo "           問題を修正してから再度 push してください。"
  echo "           チェックをスキップする場合: git push --no-verify"
  exit 1
fi
echo "[pre-push] ✅ 整合性監査通過"

echo ""
echo "[pre-push] 単体テストを実行中..."
if ! (cd "$ROOT" && make test); then
  echo ""
  echo "[pre-push] ❌ 単体テストが失敗しました。push をブロックします。"
  echo "           テストを修正してから再度 push してください。"
  echo "           チェックをスキップする場合: git push --no-verify"
  exit 1
fi
echo "[pre-push] ✅ 単体テスト通過"

echo ""
echo "[pre-push] 要件トレーサビリティ（req-coverage）を検証中..."
if ! (cd "$ROOT" && make req-coverage); then
  echo ""
  echo "[pre-push] ❌ 要件トレーサビリティ検証が失敗しました。push をブロックします。"
  echo "           未カバー要件・批准状態を修正してから再度 push してください。"
  echo "           チェックをスキップする場合: git push --no-verify"
  exit 1
fi
echo "[pre-push] ✅ 要件トレーサビリティ通過"

echo ""
echo "[pre-push] Tierトリップワイヤを検証中..."
if ! (cd "$ROOT" && make tier-tripwire); then
  echo ""
  echo "[pre-push] ❌ Tierトリップワイヤ検証が失敗しました。push をブロックします。"
  echo "           機微変更に対応する Tier-S 要件を整えてから再度 push してください。"
  echo "           チェックをスキップする場合: git push --no-verify"
  exit 1
fi
echo "[pre-push] ✅ Tierトリップワイヤ通過"

