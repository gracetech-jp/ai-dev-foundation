{
  // 基盤リポジトリ自身の開発環境。隔離境界として設計する（ADR-013 第1層）。
  //
  // マウントは「このリポジトリ」「共通の .claude」「Claude Code の私的状態」の3本だけ。
  // ホームディレクトリ・SSH 秘密鍵・Docker ソケット・兄弟ディレクトリは貼らない。
  // 2026-08-04 以前は ${localWorkspaceFolder}/.. （ホスト上の親ディレクトリ全体）と
  // ${localEnv:HOME}/.ssh を貼っていた。前者は ADR-010 でプロジェクトを projects/ 配下へ
  // 移した時点で意味が変わったまま残っていたもの、後者は秘密鍵そのもので、
  // 公式ドキュメントも ~/.ssh やクラウド認証情報をコンテナへ貼らないよう明記している。
  //
  // 帰結: origin が SSH のため、コンテナ内からの git fetch / pull はできない。
  // リモート操作はホストで行う（push は元々ホスト実施。ADR-013 の作業量の表を参照）。
  "name": "Claude Code Dev Container",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "mounts": [
    // 共通資産の配布経路（共通 deny・フック・agents・skills）。ADR-012 フェーズ2で唯一の経路になった
    "source=${localWorkspaceFolder}/.claude,target=/home/node/.claude,type=bind,consistency=delegated",

    // Claude Code の私的状態（認証情報・.claude.json・履歴・セッション）。
    // **bind ではなく名前付きボリューム**にする理由（ADR-013）:
    //   1. 上の bind は git 作業ツリーそのものなので、そこへ認証情報を置かない
    //   2. Docker が所有者を設定するため、非 root の node で権限エラーにならない
    //      （bind はホスト側の uid/gid をそのまま持ち込む）
    //   3. コンテナの再生成をまたいで残る——これが無いと Rebuild のたびに再ログインになる
    // 名前を固定しているのは、プロジェクト間で同じ資格情報を共有する現在の運用を保つため。
    "source=ai-dev-claude-state,target=/home/node/.claude-state,type=volume"
  ],

  // ファイアウォール（init-firewall.sh）が iptables/ipset を操作するために要る。
  // これが無いと postStartCommand が失敗し、waitFor によりコンテナが準備完了にならない。
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

  // 運用テレメトリ（Datadog 2ホスト）は許可リストに入れない。送信自体を止める（ADR-013）
  //
  // GH_TOKEN: gh が CI 結果・Actions の状態を読むための fine-grained PAT
  // （Actions:Read + Contents:Read・対象3リポジトリ・90日）。
  // **値はホストの環境変数から取る**（${localEnv:...}）。git 管理下のファイルにも、
  // ワークスペース内のファイルにも、イメージにも置かない——秘密の住所はホスト側のままにする。
  // 未設定なら空文字が入り、gh が未認証で失敗する（黙って別の資格情報へフォールバックしない）。
  // ホスト側の設定例: シェルの起動ファイルに `export GH_TOKEN=github_pat_...` を書く
  //
  // CLAUDE_CONFIG_DIR: Claude Code が認証情報・.claude.json・履歴を書く先を、共通 .claude
  // （＝git 作業ツリー）から名前付きボリュームへ逃がす。**未設定だと .claude.json が
  // $HOME 直下に落ち、$HOME はどのマウントにも含まれないため Rebuild で消えて再ログインになる**。
  // 設定すると settings.json の読み取り元もここへ移るため、共通資産は
  // setup-claude-config.sh が symlink で見せる（2026-08-06 実測。ADR-013 参照）。
  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude-state"
  },

  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": true
      }
    }
  },

  // 外向き既定拒否を適用する。postCreate ではなく postStart なのは、iptables の設定が
  // コンテナ再起動で消えるため（作成時1回では2回目以降の起動で無防備になる）。
  // waitFor により、遮断が完了するまでコンテナは準備完了にならない。
  //
  // setup-claude-config.sh も postStart で走らせる。共通資産への symlink はボリューム側に
  // 張るため、ボリュームがマウントされた後でないと作れない。こちらも fail-closed で、
  // 失敗すれば waitFor によりコンテナは準備完了にならない——共通 deny とフックが
  // 読まれないまま bypassPermissions で起動するのを防ぐ。
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && /usr/local/bin/setup-claude-config.sh",
  "waitFor": "postStartCommand"
}
