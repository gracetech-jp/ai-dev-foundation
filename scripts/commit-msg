#!/usr/bin/env bash
# commit-msg フック — Conventional Commits 形式をコミット時に機械強制する（docs/rules/git.md）。
# 「プロンプト任せにしない」の原則に従い、規約をフックで決定論的に検証する。
# インストール: make install-hooks（回避は git commit --no-verify。常用しない）

set -u
MSG_FILE="$1"

# 先頭の空行・コメント行(#)を除いた最初の実体行＝件名を取り出す
subject="$(grep -vE '^[[:space:]]*(#|$)' "$MSG_FILE" | head -n1)"

# マージ・リバート・fixup/squash の自動生成件名は検証を免除する
case "$subject" in
	"Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./_-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -qE "$pattern"; then
	{
		echo "❌ コミットメッセージが Conventional Commits 形式ではありません。"
		echo "   件名: $subject"
		echo "   形式: <type>(<scope>は任意)!(破壊的変更は任意): <説明>"
		echo "   type: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
		echo "   例  : feat: ユーザー認証を追加 / fix(auth): セッション切れを修正"
		echo "   詳細: docs/rules/git.md"
	} >&2
	exit 1
fi
exit 0
